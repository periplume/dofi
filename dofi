# ssh-keygen wrapper
_generateSSHKeys () {
	# create unique ssh keypair for dofi authentication to _remotePLATFORM
	# we use the comment to identify the key clearly...long, but unambiguous
	# check for existing keys...and stop if they exst
	_privKEYNAME="dofi-${_USERNAME}-${_selfHOST}-${_remotePLATFORM}-${_remoteUSERNAME}"
	_privKEYPATH="$HOME/.ssh/$_privKEYNAME"
	_pubKEYNAME="dofi-${_USERNAME}-${_selfHOST}-${_remotePLATFORM}-${_remoteUSERNAME}.pub"
	_pubKEYPATH="$HOME/.ssh/$_pubKEYNAME"
	if [ -e "${_privKEYPATH}" ]; then
		_warn "key $(_fmt path "${_privKEYNAME}") already exists"
		_ask "replace keys? [y/n] "
		while read -rsn1 _yn; do
			if [[ ${_yn} = "y" ]]; then
				echo
				_danger "replacing the keys cannot be undone!"
				read -r -p "$(_ask "type $(_fmt key indeed) to proceed") " _response
				if [[ ${_response:-} = "indeed" ]]; then
					rm "${_pubKEYPATH}"
					rm "${_privKEYPATH}"
					_info "deleted keypair ${_privKEYNAME}"
					break
				else
					_warn "cannot proceed with '${_response}'"
					_warn "keypair $(_fmt path "${_privKEYNAME}") not removed"
					return 1
				fi
			elif [[ ${_yn} = "n" ]]; then
				echo
				_warn "remove $(_fmt path "${_privKEYNAME}") keypair and try again"
				return 1
			fi
		done
	fi
	# generate new keys
	if [[ ${_sshPassphrase:-} = false ]]; then
		ssh-keygen -t ed25519 -N '' -q -C "${_privKEYNAME}" -f "${_privKEYPATH}" &
		_sshkeygenPID=$!
		_debug "waiting for ssh-keygen (pid:${_sshkeygenPID}) to complete"
		wait ${_sshkeygenPID}
	else
		_debug "tty is $(tty)"
		_debug "unsetting DISPLAY; ssh-add tries to use DISPLAY instead...stupid"
		DISPLAY=
		ssh-keygen -t ed25519 -q -C "${_privKEYNAME}" -f "${_privKEYPATH}" &
		_sshkeygenPID=$!
		_debug "waiting for ssh-keygen (pid:${_sshkeygenPID}) to complete"
		wait ${_sshkeygenPID}
	fi
}

# clip to allow easy paste with web browser
_clip() {
	# modified version of clip() from https://git.zx2c4.com/password-store/
	# copy the public key file into the clipboard (if possible)
	local _file=$1
  if [[ -n ${WAYLAND_DISPLAY:-} ]]; then
    local clip_cmd=( wl-copy )
    local paste_cmd=( wl-paste -n )
    if [[ ${X_SELECTION:-} == primary ]]; then
      clip_cmd+=( --primary )
      paste_cmd+=( --primary )
    fi
  elif [[ -n ${DISPLAY:-} ]]; then
    local clip_cmd=( xclip -selection "${X_SELECTION:-}" )
    local paste_cmd=( xclip -o -selection "${X_SELECTION:-}" )
	else
		_warn "no clipboard mechanism detected"
		return 1
	fi
	# we have a clipboard facility
	if "${clip_cmd[@]}" < "${_pubKEYPATH}"; then
		_debug "public key copied to clipboard"
	else
		_warn "key not copied to keyboard"
	fi
}

# git wrapper and passthrough
_git () {
	# check if this is a raw git command (ie 'dofi git <etc>')
	if [[ ${_gitPASSTHROUGH:-} = true ]]; then
		# in which case, pass the _gitCommand array
		git --git-dir="${_DOFIHOME}" --work-tree="${_USERHOME}" "${_gitCommand[@]}"
	else
		# otherwise, this is how the script internally uses git with _git
		git --git-dir="${_DOFIHOME}" --work-tree="${_USERHOME}" "${@}"
	fi
}

# INTERNALS
#
# these are the functions involved in setting up and starting the script
# before it really does anything useful
#
_systemCHECK () {
	local _fatal=0
	local _critical=0
	# TODO refine the conclusions, fatal, critical, etc
	# run after _setEnv is complete, check the local system
	# perform go/no-go in here
	
	# check for git
	#
	_debug "checking for 'git'"
	if ! hash git 2>/dev/null; then
	 	_warn "'git' is missing and required"
		_stateWRITE "S" "cmd" "git" "installed" "false"
		((_fatal++))
	else
		_stateWRITE "S" "cmd" "git" "installed" "true"
	fi
	
	# check for tig
	#
	_debug "checking for 'tig'"
	if ! hash tig 2>/dev/null; then
	 	_warn "'tig' is missing and recommended"
		_stateWRITE "S" "cmd" "tig" "installed" "false"
	else
		_stateWRITE "S" "cmd" "tig" "installed" "true"
	fi

	# check for curl andr wget
	#
	_debug "checking for 'curl'"
	if ! hash curl 2>/dev/null; then
	 	_warn "'curl' is missing and recommended"
		_stateWRITE "S" "cmd" "curl" "installed" "false"
		((_fatal++))
	else
		_stateWRITE "S" "cmd" "curl" "installed" "true"
	fi
	_debug "checking for 'wget'"
	if ! hash wget 2>/dev/null; then
	 	_warn "'wget' is missing and recommended"
		_stateWRITE "S" "cmd" "wget" "installed" "false"
	else
		_stateWRITE "S" "cmd" "wget" "installed" "true"
	fi

	# check for gpg
	#
	_debug "checking for 'gpg'"
	if ! hash gpg 2>/dev/null; then
	 	_warn "'gpg' is missing and recommended"
		_stateWRITE "S" "cmd" "gpg" "installed" "false"
	else
		_stateWRITE "S" "cmd" "gpg" "installed" "true"
	fi

	# check for jq
	#
	_debug "checking for 'jq'"
	if ! hash jq 2>/dev/null; then
	 	_warn "'jq' is missing and recommended"
		_stateWRITE "S" "cmd" "jq" "installed" "false"
	else
		_stateWRITE "S" "cmd" "jq" "installed" "true"
	fi

	# check for ssh-add
	#
	_debug "checking for 'ssh-add'"
	if ! hash ssh-add 2>/dev/null; then
	 	_warn "'ssh-add' is missing and required"
		_stateWRITE "S" "cmd" "ssh-add" "installed" "false"
		((_fatal++))
	else
		_stateWRITE "S" "cmd" "ssh-add" "installed" "true"
	fi

	# check for ssh-agent
	#
	_debug "checking for 'ssh-agent'"
	if ! hash ssh-agent 2>/dev/null; then
	 	_warn "'ssh-agent' is missing and required"
		_stateWRITE "S" "cmd" "ssh-agent" "installed" "false"
		((_fatal++))
	else
		_stateWRITE "S" "cmd" "ssh-agent" "installed" "true"
	fi

	# check for ssh-keygen
	#
	_debug "checking for 'ssh-keygen'"
	if ! hash ssh-keygen 2>/dev/null; then
	 	_warn "'ssh-keygen' is missing and required"
		_stateWRITE "S" "cmd" "ssh-keygen" "installed" "false"
		((_fatal++))
	else
		_stateWRITE "S" "cmd" "ssh-keygen" "installed" "true"
	fi

	# check for the github cli
	#
	_debug "checking for github 'gh' cli tool"
	if ! hash gh 2>/dev/null; then
	 	_warn "github cli 'gh' is missing"
		_stateWRITE "S" "cmd" "gh" "installed" "false"
	else
		_stateWRITE "S" "cmd" "gh" "installed" "true"
	fi

	# ssh-agent
	_debug "checking if 'ssh-agent' is running"
	_testSSHAGENT () {
		if timeout .1s ssh-add -l &>/dev/null; then
			# ssh agent is running
			_stateWRITE "S" "state" "ssh-agent" "running" "true"
		else
			_stateWRITE "S" "state" "ssh-agent" "running" "false"
			((_fatal++))
		fi
	}
	# note, we run this as a function and return true to accomodate
	# errexit
	_testSSHAGENT || :

	# pass
	_debug "checking if 'pass' is available and initialized"
	if hash pass 2>/dev/null; then
		_stateWRITE "S" "cmd" "pass" "installed" "true"
		if pass &>/dev/null; then
			_stateWRITE "S" "state" "pass" "initialized" "true"
		else
			_stateWRITE "S" "state" "pass" "initialized" "false"
		fi
	else
		_stateWRITE "S" "cmd" "pass" "installed" "false"
	fi

	# check if there is a DISPLAY (X)
	#_system["state,display,exists"]=
	if [[ -z "${DISPLAY:-}" ]]; then
		_stateWRITE "S" "state" "display" "exists" "false"
	else
		_stateWRITE "S" "state" "display" "exists" "true"
	fi
	
	# check if we own the tty or not
	#_system["state,tty,owns"]=
	if [[ $(stat -c '%U' "$(tty)") != $(whoami) ]]; then
		_stateWRITE "S" "state" "tty" "owns" "false"
	else
		_stateWRITE "S" "state" "tty" "owns" "true"
	fi

	# checking for live default route
	_debug "checking if default route is live"
	# we use the conditional-or-true because read fails if there is no route
	IFS=' ' read -r _ _ gateway _ < <(ip route show default) || true
	if ping -c 1 -W .5 "$gateway" > /dev/null 2>&1; then
		_stateWRITE "S" "state" "route" "gateway" "true"
	else
		_stateWRITE "S" "state" "route" "gateway" "false"
	fi
	# NOTE this is not an excellent test, as icmp is often filtered
	# eg room in social hub bologna, google dns test passes, while route
	# test fails, only because icmp isn't allowed, it seems

	# checking for google dns public servers
	_debug "checking if google dns resolvers are available"
	dns_servers=("8.8.8.8" "8.8.4.4")
	for server in "${dns_servers[@]}"; do
		if ping -c 1 -W 1 "$server" >/dev/null 2>&1; then
			_stateWRITE "S" "state" "dns-resolvers" "google" "true"
		else
			_stateWRITE "S" "state" "dns-resolvers" "google" "false"
    fi
	done

	# check sudo
	# first try sudo -n with any command...if this returns zero, we are good
	_debug "checking for sudo privileges"
	_testSUDO () {
		if sudo -n date >/dev/null 2>&1; then
				_stateWRITE "S" "state" "sudo" "sudoer" "true"
				_stateWRITE "S" "state" "sudo" "active" "true"
		else
			_stateWRITE "S" "state" "sudo" "active" "false"
			# we use timeout to kill sudo -v...then capture the timeout return code
			timeout --foreground -k .5 .5 sudo -S -v >/dev/null 2>&1
			_errorCode=$?
			# now match timeout exit code accordingly
			if [[ $_errorCode = 1 ]]; then
				# sudo returned 1, ie user is not in sudoers file
				_stateWRITE "S" "state" "sudo" "sudoer" "false"
			elif [[ $_errorCode = 124 ]]; then
				# user is in sudoers file (but session is inactive)
				_stateWRITE "S" "state" "sudo" "sudoer" "true"
			else
				# some other error
				_warn "unexpected error; 'timeout -k .2 .2 sudo -S -v' returned $_errorCode"
			fi
		fi
	}
	# we must this as a function and return true regardless...timeout kills
	# sudo if the session isn't active, which kills the script with the
	# errrexit setting in bash...thus:
	_testSUDO || :
}

_createSTATE () {
	# instantiate the "state db" arrays and functions to manipulate
	# an overengineered but satisfying way of keeping track of the things
	#
	# _system        external requirements and conditions [true/false]
	# _remotes       remote specifics and conditions
	#
	# create system state
	_debug "instantiating the system STATE '_system'"
	declare -gA _system
	# required and recommended external tools
	_system["cmd,ssh-keygen,installed"]=
	_system["cmd,ssh-agent,installed"]=
	_system["cmd,ssh-add,installed"]=
	_system["cmd,gpg,installed"]=
	_system["cmd,git,installed"]=
	_system["cmd,tig,installed"]=
	_system["cmd,curl,installed"]=
	_system["cmd,wget,installed"]=
	_system["cmd,pass,installed"]=
	_system["cmd,jq,installed"]=
	_system["cmd,fzf,installed"]=
	# github cli
	_system["cmd,gh,installed"]=
	# is ssh-agent running (b/c ubuntu doesn't start it automatically)
	_system["state,ssh-agent,running"]=
	# can we use pass for token and secret storage?
	# ie, has it already been initialized with a gpg keypair?
	_system["state,pass,initialized"]=
	# check if there is a DISPLAY variable
	_system["state,display,exists"]=
	# TODO write the test
	#if [[ -z "${DISPLAY:-}" ]]; then
	# check if tty is not ours
	_system["state,tty,owns"]=
	# TODO write the test
	#if [[ $(stat -c '%U' "$(tty)") != $(whoami) ]]; then
	# sudo
	_system["state,sudo,sudoer"]=
	_system["state,sudo,active"]=
	# do we have a gateway
	_system["state,route,gateway"]=
	# can we reach google dns resolvers
	_system["state,dns-resolvers,google"]=
	#
	# create a remote state
	declare -gA _remotes
	# the next function creates keys for a specific remote ($1)
	# create a set of keys for a specific remote
	# keys for which correspond to a composite string, ie
	# remote,protocol,attribute/state
	# where protocols are ssh, https, or preferred
	# where attributes are host, url, or reachable
	_addRemote () {
		[[ -z ${1:-} ]] && return 1
		_debug "instantiating the remote STATE for '$1'"
		# the values
		# TODO rename such that sort renders them into a useful order
		# ie move the word 'test' to a suffix, then tests results will
		# follow the states being tested, and will read better
		_remotes["$1,host,name"]=				# proper host name for the remote platform (set in _attach)
		_remotes["$1,host,ip"]=					# ip address (set by test-dns)
		_remotes["$1,http,host"]=     	# prepend https:// to host,name
		_remotes["$1,ssh,host"]=      	# prepend git@ to host,name
		_remotes["$1,http,url"]=				# append /user/repo to http,host
		_remotes["$1,gitssh,url"]=			# append :user/repo.git to ssh,host
		_remotes["$1,githttps,url"]=		# append .git to http,url
		_remotes["$1,user,name"]=				# remote user name (supplied as -u <name> or provided at prompt)
		_remotes["$1,repo,name"]=				# remote repo name (default dotdofi or supplied as -n <name>
		_remotes["$1,sshkey,name"]=			# ssh key name (composed as "dofi-USER-HOST-REMOTE-USER" and in ~/.ssh/)
		#
		# the corresponding tests (all true/false unless otherwise noted)
		#
		# does the ssh key actually exist
		_remotes["$1,sshkey,found"]=										# true/false
		# is there an https token cached in pass?
		_remotes["$1,githttps-token,cached"]=
		# check if the key requires a passphrase
		_remotes["$1,sshkey,password"]=
		# test dns resolution for the remote host name
		_remotes["$1,test-dns,result"]=
		# test icmp to the remote host ip
		_remotes["$1,test-icmp,result"]=
		# test http to the remote host
		_remotes["$1,test-http,result"]=
		# test ssh to the remote host
		_remotes["$1,test-ssh,result"]=
		# test 'ssh -T' with sshkey,name
		_remotes["$1,test-sshkey,result"]=
		# test http to the http,url
		_remotes["$1,test-httpurl,result"]=
		# test git ssh to gitssh,url
		_remotes["$1,test-gitssh,result"]=
		# test git https to githttps,url
		_remotes["$1,test-githttps,result"]=
		# test cli authenticated status
		_remotes["$1,cli,authenticated"]=
		# get these values only if authenticated
		_remotes["$1,cli,protocol"]=										# string (either ssh or https)
		_remotes["$1,cli,token"]=												# string
		# check for a cached cli token
		_remotes["$1,cli-token,cached"]=
	}
	# functions to read and write to the state arrays
	# arg 1 determines the kind of state:
	#   S for System
	#   R for Remote
	_stateREAD () {
		if [ "$1" = "S" ]; then
			echo "${_system["$2,$3,$4"]}"
		elif [ "$1" = "R" ]; then
			echo "${_remotes["$2,$3,$4"]}"
		else
			return 1
		fi
	}
	_stateWRITE () {
		if [ "$1" = "S" ]; then
			_system["$2,$3,$4"]="$5"
		elif [ "$1" = "R" ]; then
			_remotes["$2,$3,$4"]="$5"
		else
			return 1
		fi
	}
	_dumpSTATE () {
		if [ "$1" = "S" ]; then
			for key in "${!_system[@]}"; do
				printf "      %s=%s\n" "$(_fmt "low" "${key}")" "$(_fmt "${_system[$key]}")" 
			done | sort 
		elif [ "$1" = "R" ]; then
			for key in "${!_remotes[@]}"; do
				printf "      %s=%s\n" "$(_fmt "low" "${key}")" "$(_fmt "${_remotes[$key]}")" 
			done | sort
		else
			return 1
		fi
	}
}

# run after positional parameters are processed and before subcommands
_setEnv () {
	# set straight the environment details
	_selfNAME=$(basename "${BASH_SOURCE[0]}")
	_selfABSOLUTE=$(readlink -f "${BASH_SOURCE[0]}")
	_selfBASE=$(dirname "${_selfABSOLUTE}")
	_selfCALL=${0}
	_selfPWD=$(pwd)
	_selfHOST=$(hostname)
	_USERHOME=${HOME}
	_USERNAME=$(whoami)
	_DOFIHOME="${_USERHOME}/.dofi"
	# determine if dofi has already been installed
	# not perfectly reliable...as the user PATH may not reflect changes
	if command -v "${_selfNAME}" >/dev/null 2>&1; then
		_dofiINSTALLED=true
	else
		_dofiINSTALLED=false
	fi
	# TODO this fails if there is no .gitconfig
	if [[ -e "$HOME/.gitconfig" ]]; then
		_FULLNAME="$(git config --global --get user.name)"
		_EMAIL="$(git config --global --get user.email)"
	else
		_FULLNAME="${_USERNAME}"
		_EMAIL="unknown"
	fi
	# check for existence of _DOFIHOME
	[[ -d "${_DOFIHOME}" ]] && _dofiHOMEEXISTS=true || _dofiHOMEEXISTS=false
	# set _dofiDEVELOPER
	[[ ${_dofiDEVELOPER:-} = "true" ]] || _dofiDEVELOPER=false
	# set _DEBUG
	[[ ${_DEBUG:-} = "true" ]] || _DEBUG=false
	# print the environment details in _DEBUG mode
	_debug "$(declare -p _selfNAME)"
	_debug "$(declare -p _selfABSOLUTE)"
	_debug "$(declare -p _selfBASE)"
	_debug "$(declare -p _selfCALL)"
	_debug "$(declare -p _selfPWD)"
	_debug "$(declare -p _selfHOST)"
	_debug "$(declare -p _USERHOME)"
	_debug "$(declare -p _USERNAME)"
	_debug "$(declare -p _DOFIHOME)"
	_debug "$(declare -p _FULLNAME)"
	_debug "$(declare -p _EMAIL)"
	# print the install status of dofi
	_debug "$(declare -p _dofiINSTALLED)"
	# print the dofihome status
	_debug "$(declare -p _dofiHOMEEXISTS)"
	# print the developer status
	_debug "$(declare -p _dofiDEVELOPER)"
	# print the debug value
	_debug "$(declare -p _DEBUG)"
	# print the positional parameters
	_debug "$(declare -p _allParams)"
	_debug "$(declare -p _subCommandParams)"
}

