# install pass
_installPass () {
	sudo apt install pass
}

_initializePass () {
	# assume pass exists, but is not initialized
	# assume gpg exists
	# seems the gpg-agent just works!
	# user must attend for the passphrase
	# what we need:
	# full name
	local _name="${_FULLNAME}"
	# email
	local _email="${_EMAIL}"
	# comment (dofi-$user-$host-pass-master)
	local _comment="${_selfNAME}-${_USERNAME}-${_selfHOST}-pass-master"
	# protocol (default)
	local _protocol="default"
	# keytype (sign, auth, or encr (default))
	local _keytype="default"
	# expiration
	local _expiration="never"
	local _pinentry=
	local _display=
	local _keyid=
	# check for tty...without a tty we will use pinentry-mode=loopback
	if [[ $(stat -c '%U' "$(tty)") != $(whoami) ]]; then
		# tty isn't ours...use loopback
		_debug "tty isn't owned by me ($(whoami)), setting pinentry to loopback"
		_pinentry="--pinentry-mode=loopback"
		# export PASSWORD_STORE_GPG_OPTS='--pinentry-mode loopback'
		# TODO this should go into SYSTEM state
	fi
	if [[ -z "${DISPLAY:-}" ]]; then
		_debug "no DISPLAY found"
	else
		# we don't want pinentry to use anything but the terminal
		_debug "found DISPLAY=${DISPLAY}, will disable for gpg"
		_display="DISPLAY="
		# TODO test this
		# i think this will force tty in cases when DISPLAY is set and
		# ~/.gnupg/gpg-agent.conf doesn't have:
		# pinentry-program /usr/bin/pinentry-tty
		# which is not as ubuntu ships
	fi
	# run the gpg key create command
	_note "running the gpg key create command...choose a passphrase wisely"
	if ${_display} gpg "${_pinentry}" --quiet --quick-generate-key \
		"${_name} (${_comment}) <${_email}>" "${_protocol}" "${_keytype}" "${_expiration}"; then
		_info "gpg key created successfully"
	else
		_warn "gpg key create failed"
		return 1
	fi
	# now fetch the key id, which we need to initialize pass
	# (more fun with bash difficultisms)
	_keystring=$(${_display} gpg "${_pinentry}" --quiet --list-keys --with-colons "${_comment}" | grep ^pub)
	#_keystring=$(${_display} gpg "${_pinentry}" --quiet --list-keys --with-colons "${_comment}" | grep ^uid)
	# read it into an array so bash can split it easily
	IFS=':' read -ra _keyidArray <<< "$_keystring"
	# assign the correct field to the string variable...bash beaten (and
	# even with grep, which would be a while loop in bash...i'm ok with grep)
	_keyid="${_keyidArray[4]}"
	_debug "key id: ${_keyid}"
	# now initialize pass with our key
	if pass init "${_keyid}" >/dev/null 2>&1; then
		_debug "pass initialized successfully"
		_stateWRITE "S" "state" "pass" "initialized" "true"
		return
	else
		_stateWRITE "S" "state" "pass" "initialized" "false"
		_error "pass initialization failed"
		return 1
	fi
	# TODO there is a problem with gpg-agent and this routine
	# turns out gpg-agent is as stupid and difficult as ssh-agent...hell
	# its all around the pinentry...and tty
	# since i'm testing this as an 'sudu su - user' the tty isn't owned by
	# the user, so only LOOPBACK works, but isn't easy to force
	# the solution...force pass to always instruct gpg to use loopback
	# export PASSWORD_STORE_GPG_OPTS='--pinentry-mode loopback'

}

# install the github cli
_installGithubCLI () {
	# beautiful install routine from:
	# https://github.com/cli/cli/blob/trunk/docs/install_linux.md
	(type -p wget >/dev/null || (sudo apt update && sudo apt-get install wget -y)) \
	&& sudo mkdir -p -m 755 /etc/apt/keyrings \
	&& wget -qO- https://cli.github.com/packages/githubcli-archive-keyring.gpg | sudo tee /etc/apt/keyrings/githubcli-archive-keyring.gpg > /dev/null \
	&& sudo chmod go+r /etc/apt/keyrings/githubcli-archive-keyring.gpg \
	&& echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/githubcli-archive-keyring.gpg] https://cli.github.com/packages stable main" | sudo tee /etc/apt/sources.list.d/github-cli.list > /dev/null \
	&& sudo apt update \
	&& sudo apt install gh -y
}

