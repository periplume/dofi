_validateREMOTE () {
	# test whether a remote is reachable
	# arg1 = remote
	#
	# TODO add a full arg to allow all tests OR ls-remote only
	# TODO each test should be made into independent functions so that in
	# spot cases as we take input, we can test whether it succeeds and
	# either proceed, or stay in a while loop...better user flow, more
	# reliable
	#
	# returns 0 if git reachable, 1 if not
	# update _remoteSTATE with results
	local _remote
	_remote=$1
	
	# run the host tests first
	# test dns resolution (and icmp if dns works)
	_dnsTARGET=$(_stateREAD "R" "${_remote}" "host" "name")
	_debug "testing dns resolution for '${_dnsTARGET}'"
	if _ip=$(getent hosts "${_dnsTARGET}"); then
		_stateWRITE "R" "${_remote}" "test-dns" "result" "true"
		# keep the first field (slice at the first space)
		_ip="${_ip%% *}"
		_stateWRITE "R" "${_remote}" "host" "ip" "${_ip}"
		# test icmp
		_debug "testing icmp connectivity to '${_ip}'"
		if ping -c 1 "${_ip}" >/dev/null 2>&1; then
			_stateWRITE "R" "${_remote}" "test-icmp" "result" "true"
		fi
	else
		_stateWRITE "R" "${_remote}" "test-dns" "result" "false"
		_warn "dns resolution of '${_remote}' failed"
		_error "cannot continue with remote setup without dns"
		return 1
	fi
	
	# test http host
	_httpTARGET=$(_stateREAD "R" "${_remote}" "http" "host")
	_debug "testing http connectivity to '${_httpTARGET}'"
	_response=$(curl --write-out '%{http_code}' --silent --head --output /dev/null "${_httpTARGET}")
	_debug "http test returned response code '${_response}'"
	if [[ "${_response}" == 200 ]]; then
		_stateWRITE "R" "${_remote}" "test-http" "result" "true"
	else
		_stateWRITE "R" "${_remote}" "test-http" "result" "false"
	fi

	# test http url
	_httpURL=$(_stateREAD "R" "${_remote}" "http" "url")
	_debug "testing http validity of '${_httpURL}'"
	_response=$(curl --write-out '%{http_code}' --silent --head --output /dev/null "${_httpURL}")
	_debug "http test returned response code '${_response}'"
	if [[ "${_response}" == 200 ]]; then
		_stateWRITE "R" "${_remote}" "test-httpurl" "result" "true"
	else
		_stateWRITE "R" "${_remote}" "test-httpurl" "result" "false"
	fi

	# test ssh to host (protocol-level only)
	_sshHOST=$(_stateREAD "R" "${_remote}" "host" "name")
	_debug "testing ssh connectivity to '${_sshHOST}'"
	# check for a known_hosts file 
	if [ -e "$HOME/.ssh/known_hosts" ]; then
		# known_hosts file exists
		if ! ssh-keygen -F "${_sshHOST}" >/dev/null; then
			# not a known host, need to update known_hosts
			_debug "'${_sshHOST}' is not a known host"
			_knownHOST=false
		else
			_debug "'${_sshHOST}' is a known host"
			_stateWRITE "R" "${_remote}" "test-ssh" "result" "true"
		fi
	else
		# no known_hosts file, therefore host is unknown
		_knownHOST=false
		[ ! -d "$HOME/.ssh" ] && mkdir -m 700 "$HOME/.ssh"
		touch "$HOME/.ssh/known_hosts"
	fi
	# run the ssh-keyscan if knownHOST=false
	if [ "${_knownHOST:-}" = "false" ]; then
		if ssh-keyscan -H "${_sshHOST}" >>"${HOME}/.ssh/known_hosts" 2>/dev/null; then
			_stateWRITE "R" "${_remote}" "test-ssh" "result" "true"
		else
			_stateWRITE "R" "${_remote}" "test-ssh" "result" "false"
		fi
	fi
	
	# test if the expected keys are available, and if so, whether
	# there are passwords on the keys
	_sshKEYNAME=$(_stateREAD "R" "${_remote}" "sshkey" "name")
	_debug "checking if ssh key '${_sshKEYNAME}' exists"
	if [ -e "$HOME/.ssh/${_sshKEYNAME}" ]; then
		_stateWRITE "R" "${_remote}" "sshkey" "found" "true"
		# test if key requires passphrase
		_debug "checking if ssh key '${_sshKEYNAME}' requires a passphrase"
		# we pipe an empty string as stdin to ssh-keygen, which fails if
		# there is a passphrase, but succeeds if there is none
		if echo | ssh-keygen -y -f "$HOME/.ssh/${_sshKEYNAME}" >/dev/null 2>&1; then
			_stateWRITE "R" "${_remote}" "sshkey" "password" "true"
		else
			_stateWRITE "R" "${_remote}" "sshkey" "password" "false"
		fi
		# test ssh key (specfic)
		_sshTARGET=$(_stateREAD "R" "${_remote}" "ssh" "host")
		# this is an unusual construct, because success in this case will
		# result in a 1 being returned
		_debug "testing key against the host '${_sshTARGET}'"
		if ssh -T -i "$HOME/.ssh/${_sshKEYNAME}" "${_sshTARGET}" >/dev/null 2>&1; then
			_sshT=0
		else
			_sshT=$?
		fi
		if [[ ${_sshT} = 1 || ${_sshT} = 0 ]]; then
			_debug "'ssh -T' test returned '${_sshT}', a success"
			_stateWRITE "R" "${_remote}" "test-sshkey" "result" "true"
		elif [ ${_sshT} = 255 ]; then
			_debug "'ssh -T' test returned '${_sshT}', a failure"
			_stateWRITE "R" "${_remote}" "test-sshkey" "result" "false"
		else
			_debug "'ssh -T' test returned '${_sshT}', unexpected"
			_warn "ssh test with key returned unexpected error"
		fi
		# test git ssh
		_gitsshURL=$(_stateREAD "R" "$_remote" "gitssh" "url")
		_debug "testing connectivity to '${_gitsshURL}'"
		# validate that there is a remote
		if ! git ls-remote -q --exit-code "${_gitsshURL}" >/dev/null 2>&1; then
			_warn "remote: '${_gitsshURL}' is not reachable"
			_stateWRITE "R" "${_remote}" "test-gitssh" "result" "false"
		else
			_debug "remote: '${_gitsshURL}' is reachable"
			_stateWRITE "R" "${_remote}" "test-gitssh" "result" "true"
		fi
	# no key at all
	else
		_stateWRITE "R" "${_remote}" "sshkey" "found" "false"
	fi

	# test githttps
	_githttpsURL=$(_stateREAD "R" "$_remote" "githttps" "url")
	_tokenStatus=$(_stateREAD "R" "${_remote}" "githttps-token" "cached")
	if [[ "${_tokenStatus:-}" = "true" ]]; then
		_debug "testing connectivity to '${_githttpsURL}'"
		# validate that there is a remote
		if ! git ls-remote -q --exit-code "${_githttpsURL}" >/dev/null 2>&1; then
			_warn "remote: '${_githttpsURL}' is not reachable"
			_stateWRITE "R" "${_remote}" "test-githttps" "result" "false"
		else
			_debug "remote: '${_githttpsURL}' is reachable"
			_stateWRITE "R" "${_remote}" "test-githttps" "result" "true"
		fi
	else
		_debug "skipping test to '${_githttpsURL}'; no tokens"
	fi
	
	# test cli authenticated (and protocol and token)
	_ghUSER=$(_stateREAD "R" "${_remote}" "user" "name")
	_ghHOST=$(_stateREAD "R" "${_remote}" "host" "name")
	if gh auth switch -u "${_ghUSER}" >/dev/null 2>&1; then
		_stateWRITE "R" "${_remote}" "cli" "authenticated" "true"
		_debug "checking if '$_ghUSER' has a token for '$_ghHOST'"
		if gh auth token -u "$_ghUSER" -h "$_ghHOST" >/dev/null 2>&1; then
			_stateWRITE "R" "${_remote}" "cli" "token" "true"
		else
			_stateWRITE "R" "${_remote}" "cli" "token" "false"
		fi
		_debug "checking what protocol '$_ghUSER' has defined for '$_ghHOST'"
		_protocol=$(gh config -h "$_ghHOST" get git_protocol)
		_stateWRITE "R" "${_remote}" "cli" "protocol" "${_protocol:-}"
	else
		_stateWRITE "R" "${_remote}" "cli" "authenticated" "false"
	fi

	# check for a cached cli token
	#_remote["$1,cli-token,cached"]=
	set -x
	if pass "dofi/${_remote}.token" >/dev/null 2>&1; then
		_stateWRITE "R" "${_remote}" "cli-token" "cached" "true"
	else
		_stateWRITE "R" "${_remote}" "cli-token" "cached" "false"
	fi
	set +x
#		# test cli authenticated status
#		_remotes["$1,cli,authenticated"]=
#		# get these values only if authenticated
#		_remotes["$1,cli,protocol"]=										# string (either ssh or https)
#		_remotes["$1,cli,token"]=												# string
#		# check for a cached cli token
#		_remotes["$1,cli-token,cached"]=
#
## is there an https token cached in pass?
#		_remotes["$1,githttps-token,cached"]=

}

