	fi

	# we need cli to be authenticated
	if ! $(_stateREAD "R" "${_remote}" "cli" "authenticated"); then
		_remoteAuthenticated=false
		_warn "we need to authenticate to remote with cli gh"
		if $(_stateREAD "R" "${_remote}" "cli-token" "cached"); then
			# we already have a stashed token
			_debug "we already have a cached token we can try"
			#TODO test the validity of the cached token
		else
			# we need to generate a new token
			_ghCreateToken
		fi
		# now fetch the stashed token
		_authToken=$(_passREAD "dofi/${_remote}.token")
		# and authenticate
		_ghAuth "${_authToken}"
		# then update the state
		_stateWRITE "R" "${_remote}" "cli" "authenticated" "true"
	else
		# authenticated is true, we can use the token
		_remoteAuthenticated=true
		# get the token itself and stash it in pass for future use
		_authToken=$(gh auth token)
		_stateWRITE "R" "${_remote}" "cli" "token" "true"
		_debug "got token '${_authToken}'"
		_passADD "dofi/${_remote}.token" "${_authToken}"
		_stateWRITE "R" "${_remote}" "cli-token" "cached" "true"
		_debug "stored ${_remote} token as 'dofi/${_remote}.token'"
	fi

	# create the remote repo
	if ${_attachCreatePUBLIC:-}; then
		_p="--public"
	else
		_p="--private"
	fi
	gh repo create "${_p}" -d "$(cat "${_DOFIHOME}/description")" "${_remoteNAME}"

	# need to add git credential helper and special pass entry
	# pass dofi/github-https.credentials
	# TODO
	# keep gh-cli token in state separate from https-token cached

	# attach
	_remoteURL=$(_stateREAD "R" "${_remote}" "githttps" "url")
	_git remote add remote-primary "${_remoteURL}"
	_git push --set-upstream remote-primary main
	_git push -u remote-primary
}

_ghAuth () {
	# authenticate gh cli
	# $1 is the token to use
	echo "${1}" | gh auth login -p https -h github.com --with-token
}

_ghCreateToken () {
	# method to generate a new token and store it in pass
	# next we must create an authentication token and add it to the github
	_info "next we must generate an authentication token"
	# cli authentication setup
	_note "first, log on to your $(_fmt url "${_remoteHOST}") account"
	_note "next, click top right profile icon, then click Settings"
	_note "click 'Developer Settings' link on the bottom left"
	_note "click 'Personal access tokens' link on the bottom left"
	_note "select 'Tokens (classic)' and then click the 'Generate new token' button"
	_note "select 'Generate new token (classic)'"
	_note "give it a name that corresponds to the ssh public key:"	
	_note "  $(_fmt path "dofi-${_USERNAME}-${_selfHOST}-${_remotePLATFORM}-${_remoteUSERNAME}")"
	_note "change the 'Expiration' to 'No expiration'"
	_note "select the 'repo' group"
	_note "select the 'admin:org' group"
	_note "press the $(_fmt button 'Generate token') button"
	_note "copy the token to the clipboard and..."
	# clever method from https://stackoverflow.com/questions/1923435
	prompt=$(_ask "paste token here: ")
	unset _pat
	while IFS= read -p "$prompt" -r -s -n1 char; do
		if [[ $char == $'\0' ]]; then
			break
		fi
		prompt='*'
		_pat+="$char"
	done
	echo "${_pat}" | _passADD "dofi/${_remote}.token" "${_pat}"
	_stateWRITE "R" "${_remote}" "cli-token" "cached" "true"
	echo
}


_passADD () {
	# add new entry to pass
	# $1 = pass namespace
	# $2 = secret
	# check for tty ownership
	if ! $(_stateREAD "S" "state" "tty" "owns"); then
		# make sure to use loopback when we have no tty ownership
		export PASSWORD_STORE_GPG_OPTS='--pinentry-mode loopback'
	fi
	if echo "${2}" | pass insert -e "${1}" >/dev/null 2>&1; then
		return 0
	else
		return 1
	fi
}

_passREAD () {
	# read the password
	# $1 = pass namespace
	if ! $(_stateREAD "S" "state" "tty" "owns"); then
		# make sure to use loopback when we have no tty ownership
		export PASSWORD_STORE_GPG_OPTS='--pinentry-mode loopback'
	fi
	pass "${1}" | head -1
}

