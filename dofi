# the main entry point
main () {
	# read the positional parameters
	_getOpts "${@}"
	# set the environment accordingly
	_setEnv
	# instantiate the state systems
	_createSTATE
	# run system check (and print results in _DEBUG mode)
	_systemCHECK
	[[ ${_DEBUG:-} = "true" ]] && { _debug "system state:"; _dumpSTATE "S"; }
	# print help if no positional parameters found
	[[ -z ${_subCommand:-} ]] && { _printHelp; exit 0; }
	# execute the subCommand function (name prefixed with underscore)
	if [[ -n ${_subCommand:-} ]]; then
		# kinda wonky, i know, surely this can be improved? TODO
		_exec="_${_subCommand}"
		IFS=' ' "$_exec" "${_subCommandParams[@]}"
	fi
}
